.{
    .fingerprint = 0x7303f0090a923640,
    .name = .labelle_box2d,
    .version = "0.6.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .box2d_c = .{
            .url = "git+https://github.com/labelle-toolkit/box2d.git?ref=v3.1.1-zig#4e0953696a94081344ae12da037c38742dbd326a",
            .hash = "box2d-3.1.1-crFBkxsKAACFY700RCnH9-kxeQ_jOBFlSKcZFagiCOyT",
        },
        // labelle-core is injected by the assembler's addImport at build time.
        // This declaration allows the package to be fetched remotely and provides
        // a fallback version for standalone builds/tests.
        //
        // Pinned to the post-v1.13.1 main HEAD (2d742fb) for the
        // RFC-FLOW-VOCABULARY phase 1 contracts (`FlowNode`, `PinSpec`,
        // `PinStyle`, …) that this plugin's `FlowNodes` + `PinStyles`
        // exports depend on. Bump to a tagged release once core cuts one.
        .labelle_core = .{
            .url = "git+https://github.com/labelle-toolkit/labelle-core.git?ref=main#2d742fb8cceb176b13735cf60a09818cfe642800",
            .hash = "labelle_core-1.13.1-OauRcKkKAgCLuMifRRaeH0Abd-gMeS9jMJLunoTViFph",
            .lazy = true,
        },
        // emsdk is needed at WASM build time so we can plumb the
        // emscripten sysroot include path into the box2d C compile —
        // Zig does not ship libc headers for `wasm32-emscripten`, so
        // <math.h>/<stdlib.h>/etc. live only in emscripten's sysroot.
        // Lazy: only fetched when actually cross-compiling to wasm.
        // Same version the rest of the toolkit pins (labelle-sokol).
        .emsdk = .{
            .url = "git+https://github.com/emscripten-core/emsdk#4.0.9",
            .hash = "N-V-__8AAJl1DwBezhYo_VE6f53mPVm00R-Fk28NPW7P14EQ",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}
